# dependencies
node_modules/
**/node_modules/

# local runtime state
launcher/config.json
launcher/launcher.log
launcher/launcher.log.*
comfyui-gateway/data/
comfyui-gateway/samples/
comfyui-gateway/server/test/.tmp/
*.log
*.tsbuildinfo

# environment / secrets
.env
.env.*
!.env.example

# generated output (the committed web/dist is a release artifact)
launcher/desktop/dist/
infinite-canvas/.next/
infinite-canvas/out/
infinite-canvas/plugins/canvas/*/dist/
# launcher rewrites this at runtime with the actual gateway address
infinite-canvas/web/dist/config.js

# editor / OS
.DS_Store
.idea/
.vscode/

# local test artifacts
tmp-*

# local model files are downloaded from resources/index.json, never committed
comfyui-gateway/resources/bundled/
comfyui-gateway/resources/loras/*.safetensors
comfyui-gateway/resources/vae_approx/*.safetensors

# bundled runtime / agent metadata
.commandcode/
.update/
.update-backup/
