{
  "name": "comfy-infinity-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local OpenAI-compatible gateway that exposes ComfyUI workflows as models for Comfy Infinity.",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "mock": "node test/mock/comfyui-mock.mjs",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
